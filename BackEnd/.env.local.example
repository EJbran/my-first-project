# Local backend environment
#
# Copy this file to .env.local and fill in the local-only database credentials:
#   Copy-Item .env.local.example .env.local
#   npm run db:dev:bootstrap
#   npm run db:dev:verify
#   npm run start:dev-db
#
# .env.local is ignored by Git. Do not put production credentials in it.

NODE_ENV=development
PORT=3000

# Use a dedicated development database. The launcher refuses to start when
# DB_HOST, DB_NAME, DB_USER, or DB_PASSWORD is blank.
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=HERP_LOCAL
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Keep schema mutation disabled unless you intentionally need a local bootstrap.
DB_AUTO_SYNC=false

# Synthetic passwordless development user. This is valid only against the
# isolated local database; no company directory lookup is performed.
DEV_LOGIN_EMAIL=developer@herp.local
DEV_LOGIN_DOMAIN=HOO-PDC.vebalibya.local
DEV_LOGIN_DISPLAY_NAME=Local Development Administrator
DEV_LOGIN_SAM_ACCOUNT_NAME=herp_developer

# Optional LDAP fallback. Leave the server blank to keep it disabled locally.
AD_LDAP_SERVER=
AD_LDAP_PORT=389
AD_LDAP_USE_TLS=false

# Optional Microsoft Entra validation. Leave identifiers blank when unused.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_API_AUDIENCE=
ENTRA_ISSUER=
ENTRA_JWKS_URI=
ENTRA_GROUP_SYNC_MODE=token_or_graph

# Optional Microsoft Graph group sync. It remains disabled by default.
GRAPH_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SCOPE=https://graph.microsoft.com/.default

REFRESH_TOKEN_DAYS=7
