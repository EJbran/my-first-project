{
  "name": "backend",
  "version": "1.0.0",
  "description": "Express backend with SQL Server connection using Sequelize and mssql",
  "main": "src/server.js",
  "scripts": {
    "nodemon": "nodemon --ext js,mjs,cjs,json,ts --exec \"node -r ts-node/register/transpile-only\" src/server.js",
    "start": "node -r ts-node/register/transpile-only src/server.js",
    "start:dev-db": "node -r ./scripts/load-local-env.js -r ts-node/register/transpile-only src/server.js",
    "db:dev:bootstrap": "node scripts/bootstrap-local-dev.js",
    "db:dev:verify": "node scripts/verify-local-dev.js",
    "typecheck": "tsc --noEmit",
    "jobs:inspect": "node scripts/inspect-job-table.js",
    "vacations:inspect": "node scripts/inspect-vacation-table.js",
    "vacations:test-contract": "node -r ts-node/register/transpile-only scripts/test-vacation-schema-contract.js",
    "line-levels:inspect": "node scripts/inspect-line-level.js",
    "line-levels:preflight": "node scripts/migrate-position-line-level.js",
    "line-levels:apply": "node scripts/migrate-position-line-level.js --apply --confirm=POSITION_LINE_LEVEL",
    "line-levels:test-classifier": "node scripts/test-line-level-classifier.js",
    "employee-departments:inspect": "node scripts/inspect-employee-department-link.js",
    "employee-departments:preflight": "node scripts/migrate-employee-department-link.js",
    "employee-departments:apply": "node scripts/migrate-employee-department-link.js --apply --confirm=EMPLOYEE_DEPARTMENT_LINK",
    "organization:test-contract": "node scripts/test-organization-hierarchy-contract.js",
    "jobs:import": "node scripts/import-job-catalog.js",
    "positions:single-table:preflight": "node scripts/migrate-position-single-table.js",
    "positions:single-table:migrate": "node scripts/migrate-position-single-table.js --apply",
    "positions:single-table:verify": "node scripts/verify-position-single-table.js",
    "positions:single-table:test-mutations": "node scripts/test-position-current-state-rollback.js",
    "positions:single-table:test-create": "node scripts/test-create-employee-with-position-rollback.js",
    "positions:single-table:smoke": "node scripts/smoke-test-position-read-paths.js",
    "catalog:test-job-create-rollback": "node scripts/test-job-position-catalog-creates-rollback.js",
    "catalog:smoke": "node scripts/smoke-test-job-position-catalog-read-paths.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/ldapjs": "^3.0.6",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "ldapjs": "^3.0.7",
    "mssql": "^11.0.1",
    "sequelize": "^6.37.7",
    "tedious": "^18.6.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
